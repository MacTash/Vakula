$vidur-surface: #10151d;
$vidur-panel: #171f2a;
$vidur-panel-alt: #1d2835;
$vidur-accent: #61d6c5;
$vidur-text: #e4edf4;
$vidur-muted: #8da0b0;

Screen {
    background: $vidur-surface;
    color: $vidur-text;
}

Header {
    background: $vidur-panel-alt;
    color: $vidur-accent;
    text-style: bold;
}

Footer {
    background: $vidur-panel-alt;
    color: $vidur-muted;
}

#connection-line {
    height: 3;
    padding: 1 2;
    background: $vidur-panel;
    color: $vidur-accent;
    text-style: bold;
}

#main-tabs {
    height: 1fr;
}

TabPane {
    padding: 1 2;
    background: $vidur-surface;
}

.search-row {
    height: 3;
    margin-bottom: 1;
}

.search-row Input {
    width: 1fr;
    margin-right: 1;
}

#source-platform {
    width: 20;
    margin-right: 1;
}

.search-row Button,
.action-row Button {
    min-width: 14;
    margin-right: 1;
}

#intel-table,
#feed-table,
#saved-table {
    height: 1fr;
    min-height: 8;
    border: round $vidur-panel-alt;
    background: $vidur-surface;
}

#intel-detail,
#detail,
#saved-detail {
    height: 12;
    min-height: 6;
    max-height: 40%;
    margin-top: 1;
    padding: 1 2;
    border: round $vidur-panel-alt;
    background: $vidur-panel;
    color: $vidur-text;
    overflow-y: auto;
}

#overview-status {
    height: auto;
    min-height: 4;
    padding: 1 2;
    margin-bottom: 1;
    background: $vidur-panel;
    color: $vidur-accent;
}

.action-row {
    height: 3;
    margin-top: 1;
}

#activity {
    height: 1fr;
    padding: 1;
    border: round $vidur-panel-alt;
    background: $vidur-panel;
}

#answer {
    height: 10;
    margin-top: 1;
    padding: 1 2;
    border: round $vidur-accent;
    background: $vidur-panel;
    overflow-y: auto;
}

#source-scroll {
    height: 1fr;
}

#source-status,
#settings-status,
#settings-help {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border: round $vidur-panel-alt;
    background: $vidur-panel;
    overflow-y: auto;
}

#settings-status {
    min-height: 8;
}

#media-caption {
    height: auto;
    padding: 1 2;
    color: $vidur-accent;
    background: $vidur-panel;
}

#media-frame {
    width: 1fr;
    height: 1fr;
    min-height: 8;
    align: center middle;
    background: $vidur-surface;
}

#media-status {
    height: 3;
    padding: 1 2;
    color: $vidur-muted;
    background: $vidur-panel;
}

#confirm-dialog {
    width: 72;
    height: 13;
    max-width: 90%;
    max-height: 90%;
    padding: 1 2;
    border: round $vidur-accent;
    background: $vidur-panel;
    align: center middle;
}

#confirm-copy {
    height: 1fr;
    content-align: center middle;
    color: $vidur-text;
}

.dialog-actions {
    height: 3;
    align: center middle;
}

.dialog-actions Button {
    margin: 0 1;
}
